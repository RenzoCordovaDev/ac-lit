{
  "name": "@ac-components/ac-button-basic",
  "version": "0.1.0",
  "description": "ac-lit basic button Web Component",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locales.json": "./locales.json"
  },
  "files": [
    "/src/",
    "index.js",
    "locales.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:styles": "node ../../../scripts/compile-scss-to-lit.cjs src/button-basic.styles.scss src/button-basic.styles.js ButtonBasicStyles",
    "component:serve": "pnpm run build:styles && vite demo",
    "build": "pnpm run build:styles && vite build",
    "preview": "vite preview",
    "test": "pnpm run build:styles && web-test-runner \"test/**/*.test.js\"",
    "test:e2e": "pnpm run build && start-server-and-test preview http://localhost:4173 test:e2e:run",
    "test:e2e:run": "wdio run test_e2e/wdio.conf.js",
    "test:e2e:a11y": "pnpm run build && start-server-and-test preview http://localhost:4173 test:e2e:a11y:run",
    "test:e2e:a11y:run": "wdio run test_e2e/wdio.a11y.conf.js"
  },
  "dependencies": {
    "@ac-base/ac-component-mixin": "workspace:^",
    "@ac-base/ac-intl-mixin": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@ac-base/ac-core": "workspace:^",
    "@ac-base/ac-demo-content": "workspace:^",
    "@ac-base/ac-e2e-testing": "workspace:^",
    "@open-wc/testing": "^4.0.0",
    "@web/test-runner": "^0.18.0",
    "lit": "^3.0.0",
    "sass": "^1.79.4",
    "vite": "^5.4.8"
  }
}
