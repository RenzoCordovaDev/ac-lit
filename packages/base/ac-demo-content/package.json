{
  "name": "@ac-base/ac-demo-content",
  "version": "0.1.0",
  "description": "Contenedor centralizado para demos de componentes ac-lit (casos, idioma, ambient, modo oscuro, tamaños, panel de eventos)",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "/src/",
    "index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:styles": "node ./node_modules/@ac-base/cli/scripts/compile-scss-to-lit.cjs src/demo-content.styles.scss src/demo-content.styles.js DemoContentStyles",
    "build:styles:watch": "node ./node_modules/@ac-base/cli/scripts/compile-scss-to-lit.cjs src/demo-content.styles.scss src/demo-content.styles.js DemoContentStyles --watch",
    "dev": "pnpm run build:styles && concurrently -k -n styles,vite -c blue,green \"pnpm run build:styles:watch\" \"vite demo\"",
    "build": "pnpm run build:styles && vite build",
    "preview": "vite preview",
    "test": "pnpm run build:styles && web-test-runner \"test/**/*.test.js\"",
    "test:e2e": "pnpm run build && start-server-and-test preview http://localhost:4173 test:e2e:run",
    "test:e2e:run": "wdio run test_e2e/wdio.conf.js",
    "test:e2e:a11y": "pnpm run build && start-server-and-test preview http://localhost:4173 test:e2e:a11y:run",
    "test:e2e:a11y:run": "wdio run test_e2e/wdio.a11y.conf.js"
  },
  "dependencies": {
    "@ac-base/ac-component-mixin": "workspace:^",
    "@ac-base/ac-intl-mixin": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@ac-base/ac-core": "workspace:^",
    "@ac-base/ac-e2e-testing": "workspace:^",
    "@ac-base/cli": "workspace:^",
    "@open-wc/testing": "^4.0.0",
    "@web/test-runner": "^0.18.0",
    "concurrently": "^9.1.0",
    "lit": "^3.0.0",
    "sass": "^1.79.4",
    "vite": "^5.4.8"
  }
}
