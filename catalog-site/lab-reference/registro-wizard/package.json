{
  "name": "registro-wizard",
  "version": "0.0.0",
  "private": true,
  "description": "Componente de referencia del Laboratorio (Capítulo 1 — Construcción): wizard de registro multipaso. Pedagógico -- nunca se publica a npm, no tiene scripts de release/changeset.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "component:build:styles": "node ./node_modules/@ac-base/cli/scripts/compile-scss-to-lit.cjs src/registro-wizard.styles.scss src/registro-wizard.styles.js RegistroWizardStyles",
    "component:build:styles:watch": "node ./node_modules/@ac-base/cli/scripts/compile-scss-to-lit.cjs src/registro-wizard.styles.scss src/registro-wizard.styles.js RegistroWizardStyles --watch",
    "component:serve": "pnpm run component:build:styles && concurrently -k -n styles,vite -c blue,green \"pnpm run component:build:styles:watch\" \"vite demo\"",
    "dev": "pnpm run component:serve"
  },
  "dependencies": {
    "@ac-components/ac-api-users": "workspace:^",
    "@ac-components/ac-avatar-basic": "workspace:^",
    "@ac-components/ac-badge-basic": "workspace:^",
    "@ac-components/ac-button-basic": "workspace:^",
    "@ac-components/ac-checkbox-basic": "workspace:^",
    "@ac-components/ac-divider-basic": "workspace:^",
    "@ac-components/ac-expandable-multistep": "workspace:^",
    "@ac-components/ac-expandable-step": "workspace:^",
    "@ac-components/ac-input-basic": "workspace:^",
    "@ac-components/ac-modal-basic": "workspace:^",
    "@ac-components/ac-notification-basic": "workspace:^",
    "@ac-components/ac-radio-basic": "workspace:^",
    "@ac-components/ac-select-basic": "workspace:^",
    "@ac-components/ac-spinner-basic": "workspace:^",
    "@ac-components/ac-switch-basic": "workspace:^",
    "@ac-components/ac-text-basic": "workspace:^",
    "@ac-components/ac-tooltip-basic": "workspace:^",
    "@ac-components/ac-transition-container": "workspace:^",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@ac-base/ac-core": "workspace:^",
    "@ac-base/cli": "workspace:^",
    "concurrently": "^9.1.0",
    "sass": "^1.79.4",
    "vite": "^5.4.8"
  }
}
